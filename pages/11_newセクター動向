if target_profile:
    st.success(
        f"自動判定：**{target_profile['name']}** （{target_profile['display_symbol']}）は **{target_profile['market']}** と判定しました。"
        f"比較セクターは **{target_profile['sec_n']}**、市場基準は **{names.get(benchmark_key, benchmark_key)}** です。"
    )

with st.expander(f"📊 ① {section_title}", expanded=True):
    if market_mode == "US":
        index_rows = []
        index_rs = {}

        for index_key in ["SPY", "QQQ", "DIA", "IWM"]:
            if index_key not in hist: continue
            return_3m = calc_return(hist[index_key], 63)
            excess_3m = 0.0 if index_key == "SPY" else calc_excess_return(hist[index_key], benchmark_df, 63)
            index_rs[index_key] = excess_3m
            index_rows.append({
                "指数": names.get(index_key, index_key),
                "3か月リターン": return_3m,
                "SPY超過リターン": excess_3m
            })

        if index_rows:
            qqq_rs = index_rs.get("QQQ")
            dia_rs = index_rs.get("DIA")
            iwm_rs = index_rs.get("IWM")

            st.info(classify_us_market(qqq_rs, dia_rs, iwm_rs))

            index_df = pd.DataFrame(index_rows)
            index_display = index_df.copy()
            index_display["3か月リターン"] = index_display["3か月リターン"].apply(lambda x: f"{x:+.2f}%" if pd.notna(x) else "N/A")
            index_display["SPY超過リターン"] = index_display["SPY超過リターン"].apply(lambda x: f"{x:+.2f}pt" if pd.notna(x) else "N/A")

            # 💡 指数テーブルに色付けを適用
            try:
                styled_index = index_display.style.map(color_returns, subset=["3か月リターン", "SPY超過リターン"])
            except AttributeError:
                styled_index = index_display.style.applymap(color_returns, subset=["3か月リターン", "SPY超過リターン"])
                
            st.dataframe(styled_index, hide_index=True, use_container_width=True)

    ranking_rows = []
    for ticker in rank_list:
        if ticker not in hist: continue
        rs1m = calc_excess_return(hist[ticker], benchmark_df, 21)
        rs3m = calc_excess_return(hist[ticker], benchmark_df, 63)
        rs6m = calc_excess_return(hist[ticker], benchmark_df, 126)
        score, conditions, monthly_count = calc_trend_score(hist[ticker], benchmark_df)

        ranking_rows.append({
            "ticker": ticker,
            "セクター・銘柄": names.get(ticker, display_symbol(ticker)),
            "1か月超過": rs1m, "3か月超過": rs3m, "6か月超過": rs6m,
            "直近3区間の勝ち数": monthly_count, "4点判定": score, "状態": trend_label(score), "判定詳細": conditions
        })

    if ranking_rows:
        ranking_df = pd.DataFrame(ranking_rows)
        ranking_df["sort_value"] = pd.to_numeric(ranking_df["3か月超過"], errors="coerce")
        ranking_df = ranking_df.sort_values(by="sort_value", ascending=False, na_position="last").reset_index(drop=True)
        ranking_df["順位"] = range(1, len(ranking_df) + 1)

        display_df = ranking_df[["順位", "セクター・銘柄", "1か月超過", "3か月超過", "6か月超過", "直近3区間の勝ち数", "4点判定", "状態"]].copy()

        for col in ["1か月超過", "3か月超過", "6か月超過"]:
            display_df[col] = display_df[col].apply(lambda x: f"{x:+.2f}pt" if pd.notna(x) else "N/A")

        display_df["直近3区間の勝ち数"] = display_df["直近3区間の勝ち数"].apply(lambda x: f"{int(x)}/3" if pd.notna(x) else "N/A")
        display_df["4点判定"] = display_df["4点判定"].apply(lambda x: f"{int(x)}/4")

        # 💡 ランキングテーブルに色付けを適用
        try:
            styled_display = display_df.style.map(color_returns, subset=["1か月超過", "3か月超過", "6か月超過"])
        except AttributeError:
            styled_display = display_df.style.applymap(color_returns, subset=["1か月超過", "3か月超過", "6か月超過"])

        st.dataframe(styled_display, hide_index=True, use_container_width=True)

        if market_mode == "US":
            standard_sector_rows = ranking_df[ranking_df["ticker"].isin(US_SECTORS)]
            positive_sector_count = int((standard_sector_rows["3か月超過"] > 0).sum())
            total_available = len(standard_sector_rows)
            breadth_text = "上昇が一部セクターに集中" if positive_sector_count <= 3 else ("セクター間で強弱が混在" if positive_sector_count <= 7 else "上昇が多くのセクターへ拡大")
            st.caption(f"3か月でSPY.USを上回ったセクター数：{positive_sector_count}/{total_available}。機械的判定：{breadth_text}。")

