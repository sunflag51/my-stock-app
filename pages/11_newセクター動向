@st.cache_data(ttl=3600, show_spinner=False)
def fetch_base_info(symbol):
    if not symbol:
        return {}, False, None

    try:
        stock = yf.Ticker(symbol)

        hist = stock.history(
            period="5d",
            auto_adjust=True,
            actions=False
        )

        if hist.empty:
            return {}, False, "価格データが空でした。"

        info_warning = None

        try:
            info = stock.info or {}
        except Exception as e:
            info = {}
            info_warning = f"企業属性の取得に失敗しました: {e}"

        return info, True, info_warning

    except Exception as e:
        return {}, False, str(e)


