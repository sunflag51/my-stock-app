def format_ticker(ticker):
    """
    入力例：
    NVDA      -> NVDA
    NVDA.US   -> NVDA
    7974      -> 7974.T
    7974.JP   -> 7974.T
    7974.T    -> 7974.T
    """
    if not ticker:
        return ""

    ticker = ticker.strip().upper()

    if ticker.endswith(".US"):
        ticker = ticker[:-3]

    if ticker.endswith(".JP"):
        ticker = ticker[:-3] + ".T"

    if ticker.isdigit():
        ticker = f"{ticker}.T"

    return ticker


def display_symbol(symbol):
    """
    画面表示用コード。
    yfinanceでは米国株に.USを付けないが、
    画面上では市場を分かりやすくするため.USを付ける。
    """
    if not symbol:
        return ""

    if symbol.startswith("^"):
        return symbol

    if symbol.endswith(".T"):
        return symbol

    return f"{symbol}.US"


