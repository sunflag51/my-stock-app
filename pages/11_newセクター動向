if target_profile and target_profile["symbol"] in hist and target_profile["sec"] in hist:
    st.markdown("---")
    st.markdown("### 🎯 個別銘柄と所属セクターの直接比較")

    comparison_rows = []
    for days, label in [(21, "1か月"), (63, "3か月"), (126, "6か月")]:
        versus_market = calc_excess_return(hist[target_profile["symbol"]], benchmark_df, days)
        versus_sector = calc_excess_return(hist[target_profile["symbol"]], hist[target_profile["sec"]], days)
        comparison_rows.append({"期間": label, "市場に対する超過リターン": versus_market, "所属セクターに対する超過リターン": versus_sector})

    comparison_df = pd.DataFrame(comparison_rows)
    for col in ["市場に対する超過リターン", "所属セクターに対する超過リターン"]:
        comparison_df[col] = comparison_df[col].apply(lambda x: f"{x:+.2f}pt" if pd.notna(x) else "N/A")

    # 💡 比較テーブルに色付けを適用
    try:
        styled_comp = comparison_df.style.map(color_returns, subset=["市場に対する超過リターン", "所属セクターに対する超過リターン"])
    except AttributeError:
        styled_comp = comparison_df.style.applymap(color_returns, subset=["市場に対する超過リターン", "所属セクターに対する超過リターン"])
        
    st.dataframe(styled_comp, hide_index=True, use_container_width=True)
    st.caption("プラスなら個別銘柄が比較対象を上回り、マイナスなら比較対象を下回っています。")

