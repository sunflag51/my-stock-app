# --- 分析関数群 ---
def calc_excess_return(df_t, df_b, days):
    if df_t is None or df_b is None or "Close" not in df_t or "Close" not in df_b: return None
    aligned = pd.concat([df_t["Close"].rename("t"), df_b["Close"].rename("b")], axis=1, join="inner").dropna()
    if len(aligned) <= days: return None
    t0, t1 = aligned["t"].iloc[-days - 1], aligned["t"].iloc[-1]
    b0, b1 = aligned["b"].iloc[-days - 1], aligned["b"].iloc[-1]
    if t0 == 0 or b0 == 0: return None
    return ((t1 / t0 - 1) * 100) - ((b1 / b0 - 1) * 100)

def calc_trend_score(df_t, df_b):
    rs3m = calc_excess_return(df_t, df_b, 63)
    rs6m = calc_excess_return(df_t, df_b, 126)
    score = 0
    if rs3m and rs3m > 0: score += 1
    if rs6m and rs6m > 0: score += 1
    # 簡易化のため2点満点でラベル付け
    if score == 2: return score, "🟢 強い上昇トレンド"
    if score == 1: return score, "🟡 改善中・または調整中"
    return score, "⚪ 弱い・劣後"


