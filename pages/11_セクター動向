c_year = datetime.datetime.now().year
p_col1, p_col2 = st.columns(2)
with p_col1: sel_year = st.selectbox("表示する年", [str(c_year), str(c_year - 1), "過去3年すべて"])
with p_col2: 
    q_list = ["Q1（1～3月）", "Q2（4～6月）", "Q3（7～9月）", "Q4（10～12月）", "H1（上半期）", "H2（下半期）", "通年"]
    sel_period = st.selectbox("表示期間", ["通年"] if sel_year == "過去3年すべて" else q_list, index=(datetime.datetime.now().month - 1) // 3 if sel_year != "過去3年すべて" else 0, disabled=(sel_year == "過去3年すべて"))

chart_opts = [t for t in (JP_SECTORS if market_mode == "JP" else US_SECTORS) if t in hist]
if target_profile:
    for t in [target_profile["sec"], target_profile["symbol"]]:
        if t in hist and t not in chart_opts: chart_opts.append(t)
    def_sel = [t for t in [target_profile["symbol"], target_profile["sec"]] if t in chart_opts]
else:
    def_sel = [t for t in ["XLK", "XLE", "XLRE"] if t in chart_opts]

sel_lines = st.multiselect("グラフに表示する銘柄", options=chart_opts, default=def_sel, format_func=lambda x: names.get(x, display_symbol(x)))

if sel_lines:
    lines = sel_lines.copy()
    if benchmark_key not in lines: lines.append(benchmark_key)
    series_list = [hist[t]["Close"].rename(t) for t in lines if t in hist]

    if series_list:
        all_df = pd.concat(series_list, axis=1, join="outer").sort_index().ffill()
        if sel_year != "過去3年すべて":
            s_date, e_date = get_period_dates(sel_year, sel_period)
            all_df = all_df[(all_df.index >= pd.to_datetime(s_date)) & (all_df.index <= pd.to_datetime(e_date))]
        
        all_df = all_df.dropna(subset=[t for t in lines if t in all_df.columns])
        
        if not all_df.empty:
            chart_data = pd.DataFrame(index=all_df.index)
            for t in lines:
                if t in all_df.columns and not all_df[t].empty and all_df[t].iloc[0] > 0:
                    c_name = f"📊 市場：{names.get(t, t)}" if t == benchmark_key else names.get(t, display_symbol(t))
                    chart_data[c_name] = all_df[t] / all_df[t].iloc[0]
            st.line_chart(chart_data, use_container_width=True)
        else:
            st.warning("指定期間のデータがありません。")

