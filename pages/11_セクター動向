# 7. リターン・相対強度計算
# =========================================================

def align_close_series(df_target, df_base):
    if df_target is None or df_base is None: return pd.DataFrame()
    if "Close" not in df_target.columns or "Close" not in df_base.columns: return pd.DataFrame()
    aligned = pd.concat([df_target["Close"].rename("target"), df_base["Close"].rename("base")], axis=1, join="inner").dropna()
    return aligned

def calc_return(df, days):
    if df is None or "Close" not in df.columns: return None
    series = df["Close"].dropna()
    if len(series) <= days: return None
    start_value, end_value = series.iloc[-days - 1], series.iloc[-1]
    if start_value == 0: return None
    return (end_value / start_value - 1) * 100

def calc_excess_return(df_target, df_base, days):
    aligned = align_close_series(df_target, df_base)
    if len(aligned) <= days: return None
    target_start, target_end = aligned["target"].iloc[-days - 1], aligned["target"].iloc[-1]
    base_start, base_end = aligned["base"].iloc[-days - 1], aligned["base"].iloc[-1]
    if target_start == 0 or base_start == 0: return None
    return ((target_end / target_start - 1) * 100) - ((base_end / base_start - 1) * 100)

def calc_relative_ratio_rising(df_target, df_base, days=21):
    aligned = align_close_series(df_target, df_base)
    if len(aligned) <= days: return None
    relative_ratio = aligned["target"] / aligned["base"]
    old_value, current_value = relative_ratio.iloc[-days - 1], relative_ratio.iloc[-1]
    if pd.isna(old_value) or pd.isna(current_value): return None
    return bool(current_value > old_value)

def count_recent_monthly_outperformance(df_target, df_base):
    aligned = align_close_series(df_target, df_base)
    if len(aligned) < 64: return None
    windows = [(-64, -43), (-43, -22), (-22, -1)]
    outperform_count = 0
    for start_pos, end_pos in windows:
        target_start, target_end = aligned["target"].iloc[start_pos], aligned["target"].iloc[end_pos]
        base_start, base_end = aligned["base"].iloc[start_pos], aligned["base"].iloc[end_pos]
        if target_start == 0 or base_start == 0: continue
        if (target_end / target_start - 1) > (base_end / base_start - 1): outperform_count += 1
    return outperform_count

def calc_trend_score(df_target, df_base):
    rs3m = calc_excess_return(df_target, df_base, 63)
    rs6m = calc_excess_return(df_target, df_base, 126)
    ratio_rising = calc_relative_ratio_rising(df_target, df_base, 21)
    monthly_count = count_recent_monthly_outperformance(df_target, df_base)
    conditions = {
        "3か月超過リターンがプラス": (rs3m is not None and rs3m > 0),
        "6か月超過リターンがプラス": (rs6m is not None and rs6m > 0),
        "相対価格比が1か月前より上昇": (ratio_rising is True),
        "直近3区間中2区間以上で市場超え": (monthly_count is not None and monthly_count >= 2)
    }
    score = sum(1 for value in conditions.values() if value)
    return score, conditions, monthly_count

def trend_label(score):
    if score == 4: return "🟢 相対上昇が継続中（4点）"
    if score == 3: return "🟡 相対上昇が進行中（3点）"
    if score == 2: return "🟠 改善候補（2点）"
    return "⚪ 弱い・一時反発の可能性（0～1点）"


