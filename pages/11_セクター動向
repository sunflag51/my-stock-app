def build_dynamic_profile(symbol, info):
    if not symbol: return None
    is_jp = symbol.endswith(".T")
    short_name = info.get("shortName", symbol)

    if symbol in MANUAL_PROFILES:
        manual = MANUAL_PROFILES[symbol]
        return {
            "symbol": symbol, "display_symbol": display_symbol(symbol), "name": short_name,
            "is_jp": is_jp, "market": "日本株" if is_jp else "米国株",
            "sec": manual["sec"], "sec_n": manual["sec_n"], "idx": manual["idx"]
        }

    # デフォルトのフォールバック
    if is_jp:
        sec_tic, sec_name = "1306.T", "TOPIX連動ETF"
        index_ticker = "^TOPX"
    else:
        sec_tic, sec_name = "SPY", "米国大型株市場（SPY.US）"
        index_ticker = "SPY"

    return {
        "symbol": symbol, "display_symbol": display_symbol(symbol), "name": short_name,
        "is_jp": is_jp, "market": "日本株" if is_jp else "米国株",
        "sec": sec_tic, "sec_n": sec_name, "idx": index_ticker
    }


