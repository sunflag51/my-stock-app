def get_colored_html(val):
    if isinstance(val, str) and '+' in val:
        return f"<span style='color:#009900; font-weight:bold;'>{val}</span>"
    elif isinstance(val, str) and '-' in val and val != '-':
        return f"<span style='color:#ff4444; font-weight:bold;'>{val}</span>"
    return str(val)


