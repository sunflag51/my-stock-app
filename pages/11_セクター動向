def align_close_series(df_target, df_base):
    if df_target is None or df_base is None: return pd.DataFrame()
    if "Close" not in df_target.columns or "Close" not in df_base.columns: return pd.DataFrame()
    return pd.concat([df_target["Close"].rename("target"), df_base["Close"].rename("base")], axis=1, join="inner").dropna()

def calc_return(df, days):
    if df is None or "Close" not in df.columns: return None
    series = df["Close"].dropna()
    if len(series) <= days: return None
    if series.iloc[-days - 1] == 0: return None
    return (series.iloc[-1] / series.iloc[-days - 1] - 1) * 100

def calc_excess_return(df_target, df_base, days):
    aligned = align_close_series(df_target, df_base)
    if len(aligned) <= days: return None
    tgt_start, tgt_end = aligned["target"].iloc[-days - 1], aligned["target"].iloc[-1]
    base_start, base_end = aligned["base"].iloc[-days - 1], aligned["base"].iloc[-1]
    if tgt_start == 0 or base_start == 0: return None
    return ((tgt_end / tgt_start - 1) * 100) - ((base_end / base_start - 1) * 100)

def calc_trend_score(df_target, df_base):
    rs3m = calc_excess_return(df_target, df_base, 63)
    rs6m = calc_excess_return(df_target, df_base, 126)
    
    aligned = align_close_series(df_target, df_base)
    ratio_rising = False
    if len(aligned) > 21:
        ratio = aligned["target"] / aligned["base"]
        if ratio.iloc[-1] > ratio.iloc[-22]: ratio_rising = True

    monthly_count = 0
    if len(aligned) >= 64:
        for s, e in [(-64, -43), (-43, -22), (-22, -1)]:
            if aligned["target"].iloc[s] != 0 and aligned["base"].iloc[s] != 0:
                if (aligned["target"].iloc[e] / aligned["target"].iloc[s]) > (aligned["base"].iloc[e] / aligned["base"].iloc[s]):
                    monthly_count += 1

    cond = {
        "3か月超過リターンがプラス": (rs3m is not None and rs3m > 0),
        "6か月超過リターンがプラス": (rs6m is not None and rs6m > 0),
        "相対価格比が1か月前より上昇": ratio_rising,
        "直近3区間中2区間以上で市場超え": (monthly_count >= 2)
    }
    score = sum(1 for v in cond.values() if v)
    return score, cond, monthly_count

def trend_label(score):
    if score == 4: return "🟢 相対上昇が継続中（4点）"
    if score == 3: return "🟡 相対上昇が進行中（3点）"
    if score == 2: return "🟠 改善候補（2点）"
    return "⚪ 弱い・一時反発の可能性（0～1点）"


