@st.cache_data(ttl=3600, show_spinner=False)
def fetch_market_trend_data(extra_ticker_pairs=()):
    tickers = CORE_TICKERS.copy()
    names = BASE_NAMES.copy()
    
    for ticker, display_name in extra_ticker_pairs:
        tickers[ticker] = ticker
        names[ticker] = display_name

    history = {}
    errors = {}
    yahoo_symbols = list(tickers.values())

    try:
        # 💡 Tickerごとのループ通信を廃止し、yf.downloadで一元化
        df_bulk = yf.download(yahoo_symbols, period="3y", group_by="ticker", threads=True, progress=False)
        
        if df_bulk.empty:
            return history, names, {"all": "一括データ取得に失敗しました。"}
            
        if isinstance(df_bulk.columns, pd.MultiIndex):
            for key, yahoo_symbol in tickers.items():
                if yahoo_symbol in df_bulk.columns.get_level_values(0).unique():
                    df = df_bulk[yahoo_symbol].dropna(how="all").copy()
                    if not df.empty:
                        # タイムゾーンの除去
                        if df.index.tz is not None:
                            df.index = df.index.tz_localize(None)
                        # 株式分割/配当調整後の価格をCloseとして使用
                        if "Adj Close" in df.columns:
                            df["Close"] = df["Adj Close"]
                        history[key] = df
                    else:
                        errors[key] = "価格データが空です。"
        else:
            # 1銘柄のみ取得された場合のフェイルセーフ
            df = df_bulk.dropna(how="all").copy()
            if not df.empty:
                if df.index.tz is not None: df.index = df.index.tz_localize(None)
                if "Adj Close" in df.columns: df["Close"] = df["Adj Close"]
                history[list(tickers.keys())[0]] = df

    except Exception as e:
        errors["bulk"] = f"取得エラー: {str(e)}"

    return history, names, errors


