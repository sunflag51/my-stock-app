@st.cache_data(ttl=3600, show_spinner=False)
def fetch_base_info(symbol):
    if not symbol: return {}, False, None
    try:
        # 💡 yf.Ticker().info はフリーズの最大原因となるため廃止
        # 代わりに軽量なyf.downloadで価格データが存在するかだけをチェック
        df = yf.download(symbol, period="5d", progress=False)
        if df.empty:
            return {}, False, "データが見つかりませんでした。"
        
        safe_info = {
            "sector": "", "industry": "",
            "shortName": symbol, "longName": symbol
        }
        return safe_info, True, "（※フリーズ防止のため、企業セクターの自動取得はオフにしています）"
    except Exception as e:
        return {}, False, str(e)


